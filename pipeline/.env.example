# Dev Life with Uche — environment configuration
# Copy this file to .env and fill in the values. Never commit .env.
# Validate everything with: python validate_keys.py

# --- Required: API keys -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
ELEVENLABS_API_KEY=sk_your-key-here
GOOGLE_API_KEY=your-google-api-key-here

# --- Optional: Pexels (stock imagery) ---------------------------------------
PEXELS_API_KEY=

# --- Image generation -------------------------------------------------------
# Defaults to gemini-3-pro-image-preview if unset.
IMAGEN_MODEL=gemini-3-pro-image-preview

# --- ElevenLabs voice -------------------------------------------------------
# Get a voice ID from https://elevenlabs.io/app/voice-library or your own clones.
ELEVENLABS_VOICE_ID=your-voice-id-here

# --- YouTube publishing -----------------------------------------------------
# Path to OAuth client secret downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_PATH=./client_secret.json
PUBLISH_DAY_1=Tuesday
PUBLISH_DAY_2=Thursday
PUBLISH_DAY_3=Saturday
PUBLISH_HOUR=14
PUBLISH_TIMEZONE=Europe/Berlin
APPROVAL_WINDOW_HOURS=24
NOTIFICATION_EMAIL=

# --- Pipeline tuning --------------------------------------------------------
MAX_CONCURRENT_IMAGE_REQUESTS=5
TARGET_SCENE_DURATION_SECONDS=15
SCRIPT_MIN_WORDS=1400
SCRIPT_MAX_WORDS=1750
